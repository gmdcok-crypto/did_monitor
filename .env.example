# Railway MySQL 플러그인 연결 시 보통 MYSQL_URL 이 자동 주입됩니다.
# 값을 레포/채팅에 넣지 마세요. Railway Variables(또는 로컬 .env)에만 둡니다.
#
# MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/railway
#
# 고객 DID 요약 API 토큰 (고객 Railway MONITOR_TOKEN 과 동일하게)
# MONITOR_TOKEN=change-me-monitor-token
#
# 목록 로드 시 고객 /api/monitor/summary 실시간 호출 (기본 ON, 끄려면 0)
# MONITOR_LIVE_SUMMARY=1
#
# 로컬에서 DB 없이 UI만 볼 때:
# ALLOW_MOCK_INSTANCES=1
# NODE_ENV=development
